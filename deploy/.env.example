# ==============================================================================
# Walkie Talkie Production Configuration - Hostinger VPS
# Copy this file to .env on your VPS and update with your actual values:
# cp deploy/.env.example deploy/.env
# ==============================================================================

# 1. DOMAINS & PUBLIC IP
# Point DNS A-records for both subdomains to your Hostinger VPS public IP
APP_DOMAIN=talk.example.com
RTC_DOMAIN=rtc.example.com
VPS_PUBLIC_IP=203.0.113.10

# 2. APPLICATION SECRETS
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_32_character_jwt_secret_key_123456

# 3. POSTGRESQL DATABASE (Private to Docker network, never exposed publicly)
POSTGRES_USER=walkie
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password_89abcd
POSTGRES_DB=walkietalkie
DATABASE_URL=postgresql://walkie:replace_with_a_secure_random_db_password_89abcd@postgres:5432/walkietalkie

# 4. LIVEKIT WEBRTC SERVER CREDENTIALS
# Must match the keys in deploy/livekit.yaml
LIVEKIT_API_KEY=talk_api_key_walkie
LIVEKIT_API_SECRET=secret_livekit_key_at_least_32_characters_long_prod
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=https://rtc.example.com

# 5. RUNTIME SETTINGS
NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://talk.example.com
TURN_MAX_DURATION_MS=30000
TURN_HEARTBEAT_TIMEOUT_MS=3500
